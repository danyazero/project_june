pub class Main {
    constructor(v string) {
        print!("Hello, " + v + "!")
    }

    pub fn sum(a int, b int) int {
        return a + b
    }

    pub fn* main(args []string) {
        a := Main { "Danya" }

        for i in 0..5 {
            print!(a.sum(5, i))
            print!(", ")
        }

        return
    }
}